{
  "name": "Universal Topology Experiment",
  "description": "Testing universal topology approach with task-specific adapters",
  "task_name": "CartPole-v1",
  "universal_input_dim": 6,
  "universal_output_dim": 3,
  "task_input_dim": 4,
  "task_output_dim": 2,
  "hidden_size": 100,
  "topologies": [
    "small_world",
    "modular",
    "hybrid",
    "fully_connected"
  ],
  "total_timesteps": 50000,
  "learning_rate": 0.0003,
  "n_steps": 2048,
  "batch_size": 64,
  "n_epochs": 10,
  "gamma": 0.99,
  "gae_lambda": 0.95,
  "clip_range": 0.2,
  "ent_coef": 0.01,
  "eval_episodes": 100,
  "topology_params": {
    "small_world": {
      "k": 4,
      "p": 0.3,
      "num_layers": 1,
      "inter_layer_prob": 0.1
    },
    "modular": {
      "num_modules": 4,
      "intra_module_prob": 0.8,
      "inter_module_prob": 0.1,
      "num_layers": 1,
      "inter_layer_prob": 0.1
    },
    "hybrid": {
      "num_modules": 4,
      "k": 4,
      "p": 0.3,
      "inter_module_prob": 0.1,
      "num_layers": 1,
      "inter_layer_prob": 0.1
    },
    "fully_connected": {
      "intra_layer_prob": 0.8,
      "inter_layer_prob": 0.5,
      "num_layers": 1
    }
  }
}